{
  "permissions": {
    "allow": [
      "Bash(craftctl doctor*)",
      "Bash(craftctl status*)",
      "Bash(craftctl projects*)",
      "Bash(craftctl validate*)",
      "Bash(craftctl logs*)",
      "Bash(craftctl diagnose*)",
      "Bash(craftctl footprint*)",
      "Bash(craftctl kb-search*)",
      "Bash(craftctl capabilities*)",
      "Bash(craftctl next*)",
      "Bash(craftctl handoff*)",
      "Bash(python -m unittest*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Bash(craftctl approve-spec*)",
      "Bash(craftctl request-build*)",
      "Bash(craftctl decide*)",
      "Bash(craftctl build*)",
      "Bash(craftctl evidence*)",
      "Bash(craftctl delete*)",
      "Bash(craftctl release*)",
      "Bash(craftctl new*)",
      "Bash(git push*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"" }
        ]
      }
    ]
  }
}
